# Run with: node --env-file=.env src/index.js (Node 22.18+)
PORT=8787
HOST=127.0.0.1
# Exact installed Chrome extension origins, comma separated. No wildcard.
ALLOWED_EXTENSION_ORIGINS=
ODDSSEER_SEARCH_MODE=public
# Optional comments/query understanding. Never put keys in extension VITE vars.
OPENROUTER_API_KEY=
OPENROUTER_COMMENT_MODEL=deepseek/deepseek-chat
OPENROUTER_TIMEOUT_MS=8000
# Optional original hybrid search (dedicated local PostgreSQL with pgvector).
DATABASE_URL=
EMBEDDING_PROVIDER=none
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-multilingual-v3.0
